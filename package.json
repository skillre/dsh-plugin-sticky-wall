{
  "name": "@skillre/dsh-plugin-sticky-wall",
  "version": "0.8.0",
  "description": "便签墙：DSH 侧栏的自由画布便签板，可拖动摆放、一键整理，正文按 Markdown 渲染",
  "icon": "./icon.svg",
  "type": "module",
  "license": "MIT",
  "author": "skillre",
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "packageManager": "npm@11.12.1",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./compatibility.json": "./compatibility.json",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json",
    "./client": {
      "browser": "./lib/client.js",
      "default": "./lib/client.js"
    }
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "compatibility.json",
    "locale/*.json",
    "icon.svg",
    "docs/DETAIL.md",
    "docs/DETAIL.zh.md",
    "docs/preview.svg",
    "docs/preview.zh.svg",
    "README.md",
    "README.en.md",
    "UNINSTALL.md",
    "LICENSE",
    "!docs/PREVIEW.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skillre/dsh-plugin-sticky-wall.git"
  },
  "bugs": {
    "url": "https://github.com/skillre/dsh-plugin-sticky-wall/issues"
  },
  "homepage": "https://github.com/skillre/dsh-plugin-sticky-wall#readme",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "cordis",
    "sticky-notes",
    "notes",
    "便签"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-connection"
      ]
    }
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && tsc -p tsconfig.build.json && node scripts/build-client.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "npm run build:client && vitest run",
    "pack:check": "npm run build && publint && npm pack --dry-run --json --ignore-scripts",
    "check": "npm run preview:check && npm run typecheck && npm test && npm run check:lib && npm run pack:check",
    "changeset": "changeset",
    "version": "changeset version",
    "release:prepare": "node scripts/prepare-release.mjs",
    "prepack": "npm run build",
    "build:client": "node scripts/build-client.mjs",
    "test:integration": "node scripts/verify-isolated.mjs",
    "test:market": "node scripts/verify-market-install.mjs",
    "check:lib": "npm run build && node scripts/verify-lib-committed.mjs",
    "preview:check": "node scripts/preview.mjs check"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.2",
    "@deepseek-ai/cordis": "4.1.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "~18.3.31",
    "esbuild": "^0.25.0",
    "jsdom": "^25.0.1",
    "publint": "^0.3.24",
    "react": "18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "7.0.2",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.19.0",
    "zod": "^4.6.7"
  }
}
